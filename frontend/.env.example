# ==============================================================================
# UNIVIA - FRONTEND ENVIRONMENT VARIABLES EXAMPLE
# Copia este archivo a .env.local y completa con tus credenciales
# ==============================================================================

# Supabase Client Configuration
# Obtén estos valores desde https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API Service Base URL
# URL base del backend FastAPI (sin /api)
NEXT_PUBLIC_API_URL=http://localhost:8000

