# Ejemplo de variables de entorno del backend de UniVia.
# Copia este archivo como .env y completa con tus propios valores.
# NUNCA subas el archivo .env real al repositorio.

# --- Supabase (obligatorias: la API no arranca sin ellas) ---
# Obtén estos valores desde:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=tu_url_de_supabase_aqui
SUPABASE_ANON_KEY=tu_anon_key_de_supabase_aqui

# Llave de servicio: omite RLS. Se usa solo en operaciones administrativas
# (por ejemplo, crear usuarios en el registro). Trátala como secreto y nunca
# la expongas al frontend.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Secreto JWT del proyecto, para validar tokens de sesión.
SUPABASE_JWT_SECRET=tu_jwt_secret_aqui

# --- Proveedores de IA ---
# Gemini hace el OCR DE VISION y los EMBEDDINGS (volumen, cuenta separada
# porque es lo que primero agota cuota); OpenAI queda como respaldo de ambos
# y sigue haciendo etiquetado/estructurado de sílabos; Claude hace la
# GENERACIÓN (lo que ve el estudiante). Ver app/core/llm.py.
#
# Gemini: OCR de Vision + embeddings (fallback: OpenAI si falta esta key).
# https://aistudio.google.com/apikey
GEMINI_VISION_API_KEY=tu_gemini_api_key_aqui
GEMINI_VISION_MODEL=gemini-2.5-flash
# gemini-embedding-001 se pide con output_dimensionality=1536 para calzar con
# la columna pgvector de resource_chunks sin migrar el esquema. Cambiar de
# proveedor de embeddings obliga a re-vectorizar TODO el corpus
# (scripts_manuales/revectorizar_chunks.py) porque los espacios vectoriales
# de dos modelos distintos no son comparables.
GEMINI_EMBED_MODEL=gemini-embedding-001
#
# OpenAI: etiquetado, estructurado de sílabos, y respaldo de OCR/embeddings
# si no hay GEMINI_VISION_API_KEY.
# https://platform.openai.com/api-keys
# Una key restringida necesita, en `Model capabilities`:
#   Embeddings (/v1/embeddings)              -> Request
#   Chat completions (/v1/chat/completions)  -> Request
OPEN_AI_INGEST_API_KEY=tu_openai_api_key_aqui
OPENAI_EMBED_MODEL=text-embedding-3-small
# Modelo de OCR de respaldo; necesita visión para leer páginas renderizadas a imagen.
OPENAI_INGEST_MODEL=gpt-4.1-mini

# Claude: evaluaciones y tutor RAG, nada más.
# https://console.anthropic.com -> API Keys (saldo prepago en Billing)
CLAUDE_GEN_API_KEY=tu_claude_api_key_aqui
# claude-sonnet-5 equilibra costo y calidad; claude-opus-5 es el más capaz.
CLAUDE_GEN_MODEL=claude-sonnet-5

# Groq: chatbot flotante. Va por el free tier (sin costo), separado de Claude
# para no consumir saldo prepago en conversación casual. Su API es compatible
# con la de OpenAI, así que se usa el mismo SDK con otra base_url.
# https://console.groq.com/keys
GROQ_API_KEY=tu_groq_api_key_aqui
# Verifica el catálogo de tu cuenta antes de cambiarlo: Groq rota los modelos
# del free tier y pedir uno retirado devuelve 404. Alternativas más livianas:
# openai/gpt-oss-20b, qwen/qwen3.8-27b.
GROQ_MODEL=openai/gpt-oss-120b

# Google Drive (ingesta de recursos, scripts_manuales/ingestar_recursos_drive.py):
# https://console.cloud.google.com/apis/credentials
GOOGLE_DRIVE_API_KEY=tu_google_drive_api_key_aqui

# --- Configuración de la API ---
# URL del frontend. Se usa para armar el enlace del correo de recuperación
# de contraseña, que debe llevar al usuario a la web, no a la API.
FRONTEND_URL=http://localhost:3000

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Notificación de solicitudes de invitado (SMTP) ---
# Destinatarios de las solicitudes de acceso invitado, separados por coma.
DEV_NOTIFICATION_EMAILS=tu_correo_dev@ejemplo.com
# Servidor SMTP saliente. Si está vacío, la solicitud de invitado no se envía.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@univiap.pe
